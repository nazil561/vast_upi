rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==================== USERS ====================
    // Users can read their own profile, but cannot directly modify it
    // Profile is created/updated only via Cloud Functions
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Only via Cloud Functions
    }
    
    // ==================== WALLETS ====================
    // Wallets are read-only for clients
    // All balance modifications must go through Cloud Functions
    match /wallets/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Only via Cloud Functions
    }
    
    // ==================== SECURITY POLICIES ====================
    // Users can read and update their own security policies
    match /securityPolicies/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
    
    // ==================== PAYMENTS ====================
    // Payments can be read by sender or recipient
    // Creation is allowed for authenticated users
    // Status updates and balance changes must go through Cloud Functions
    match /payments/{paymentId} {
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.senderUserId ||
         request.auth.uid == resource.data.recipientUserId ||
         request.auth.uid == resource.data.senderId ||
         request.auth.uid == resource.data.recipientId);
      
      allow create: if false;
      
      // Clients cannot directly update payment status - must use Cloud Functions
      allow update: if false;
      
      allow delete: if false;
    }
    
    // Payment events are append-only
    match /payments/{paymentId}/events/{eventId} {
      allow read: if request.auth != null &&
        (get(/databases/$(database)/documents/payments/$(paymentId)).data.senderUserId == request.auth.uid ||
         get(/databases/$(database)/documents/payments/$(paymentId)).data.recipientUserId == request.auth.uid ||
         get(/databases/$(database)/documents/payments/$(paymentId)).data.senderId == request.auth.uid ||
         get(/databases/$(database)/documents/payments/$(paymentId)).data.recipientId == request.auth.uid);
      allow create: if false; // Only via Cloud Functions
      allow update, delete: if false;
    }

    match /kycProfiles/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /demoAccounts/{accountId} {
      allow read: if request.auth != null && request.auth.uid == accountId;
      allow write: if false;
    }

    match /systemEvents/{eventId} {
      allow read, write: if false;
    }

    match /banks/{bankId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    
    // ==================== HELPER FUNCTIONS ====================
    // Function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Function to check if user owns the resource
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
  }
}
